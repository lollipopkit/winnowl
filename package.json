{
  "name": "reviewbot",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:clean": "bash scripts/check-clean.sh",
    "build": "tsc -b",
    "build:web": "pnpm --filter @reviewbot/web-console build",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json",
    "typecheck:web": "pnpm --filter @reviewbot/web-console typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "config:schema": "tsx packages/config/scripts/export-schema.ts",
    "config:schema:check": "tsx packages/config/scripts/export-schema.ts --check",
    "docs:config": "tsx packages/config/scripts/export-reference.ts",
    "docs:config:check": "tsx packages/config/scripts/export-reference.ts --check",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "eval:gold": "tsx scripts/eval-gold.ts",
    "eval:gold:run": "tsx scripts/eval-gold-run.ts",
    "eval:recall": "tsx scripts/eval-recall.ts",
    "eval:verify": "tsx scripts/eval-verify.ts",
    "check": "pnpm typecheck && pnpm typecheck:web && pnpm lint && pnpm depcruise && pnpm config:schema:check && pnpm docs:config:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@reviewbot/agent-pi": "workspace:*",
    "@reviewbot/eval": "workspace:*",
    "@reviewbot/findings": "workspace:*",
    "@reviewbot/git-repository": "workspace:*",
    "@reviewbot/i18n": "workspace:*",
    "@reviewbot/ids": "workspace:*",
    "@reviewbot/plugins": "workspace:*",
    "@reviewbot/prompts": "workspace:*",
    "@reviewbot/review-orchestrator": "workspace:*",
    "@reviewbot/review-profile": "workspace:*",
    "@reviewbot/review-runtime": "workspace:*",
    "@reviewbot/sandbox": "workspace:*",
    "@reviewbot/security-agent": "workspace:*",
    "@reviewbot/verification": "workspace:*",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.8.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^3.12.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.5"
  }
}
