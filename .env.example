# 复制为 .env(已 gitignore,不提交密钥)。**本地开发/live 测试**用:runner-supervisor 本地 node 运行与 vitest 会自动加载根 .env。
# (容器 compose 部署用另一份完整模板 deploy/.env.example → deploy/.env,两者上下文不同、非冗余。)
# 支持 ${VAR} / $VAR 从 shell 环境展开;已 export 的 shell 变量优先(不被 .env 覆盖)。
# 单引号值不展开(字面);双引号/无引号展开。

# ── LLM(review 用真实模型;OpenAI 兼容端点)─────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=your-model-name
LLM_BASE_URL=https://your-endpoint/v1
# 引用已有的 shell 变量,避免把密钥写进文件:
LLM_API_KEY=${LLM_API_KEY}
# 或直接写死:LLM_API_KEY=sk-...
# 若模型不在 pi 目录,借用同 api 的目录模型作模板(请求仍发 LLM_MODEL)
# LLM_TEMPLATE_MODEL=gpt-4o

# ── 提速旋钮(§加速;均可选,默认已合理)────────────────────────────
# prompt cache 保留档(none|short|long,默认 long):稳定前缀跨 turn/invocation 复用,省输入 token 处理。
# LLM_CACHE_RETENTION=long
# pre-verify 去重策略(token|embedding|llm,默认 token):
#   token=词集 Dice(同步、保流水化);embedding=语义 cosine(需下方 embedding 配置);llm=语义聚类(batch,牺牲流水化换精度)。
# LLM_DEDUP=token
# LLM_DEDUP=embedding 时必填:embedding 模型(走 LLM_BASE_URL 的 OpenAI 兼容 /embeddings;端点须在 ZDR 白名单)。
# LLM_EMBED_MODEL=text-embedding-3-small
# 可选:embedding 判重 cosine 阈值(默认 0.86)。
# LLM_DEDUP_THRESHOLD=0.86

# ── 运行时(runner-supervisor)──────────────────────────────────────
# DATABASE_URL=postgres://user:pass@localhost:5432/reviewbot
# RUNNER_POOL=default
# LOG_LEVEL=info
# post-merge 跟进(§34)平台级下线中:create-follow-up-issue 无判据,每次默认分支 merge 都开 issue。
# 设 1 才会跑(仓库 actions.post_merge.enabled 仍需为 true);修好判据前不建议打开。
# console 平台设置 post_merge.enabled 优先,这里是回退值。
# POST_MERGE_ENABLED=1

# ── Provider 凭据(子系统 A env 凭据源;生产建议用 KMS 加密存储)──────
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# PROVIDER_TOKEN=  # GitLab/Forgejo token(单 host dev)

# ── Onboarding(control-api)────────────────────────────────────────
# 还没加入任何组织的用户会被 console 整屏拦下,引导去装 App —— 按钮地址取自这里。
# 缺省则引导页只讲步骤、不给链接(猜出来的安装地址会把用户送去装别人的 App)。
# slug 同时用于查自身 bot 账号(`<slug>[bot]`)拼 commit 邮箱;配错则 bot 提交挂不到账号、头像空白。
# 缺省时退到 BOT_NAME。
# GITHUB_APP_SLUG=winnowl                                  # → https://github.com/apps/<slug>/installations/new
# APP_INSTALL_URL=https://github.com/apps/winnowl/installations/new  # 非 GitHub / 自建 forge 用完整地址覆盖
