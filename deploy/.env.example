# winnowl deploy env template. Copy to deploy/.env and fill in; never commit real secrets.

# --- Ports / binds ---
# Backends bind 127.0.0.1 by default; the edge profile's web (nginx) is the only public entry.
# WEB_PORT=8000                 # edge: nginx public port
#                               # set 127.0.0.1:8000 when a host reverse proxy (Caddy etc.) fronts it
# DOCKER_SOCK=/run/user/1000/docker.sock  # rootless Docker: host socket the runner starts sandboxes on
# CONTROL_API_BIND=127.0.0.1    # 0.0.0.0 to expose control-api directly
# CONTROL_API_PORT=8080
# WEBHOOK_BIND=127.0.0.1        # 0.0.0.0 to expose webhook directly
# WEBHOOK_PORT=8081

# --- docker-compose.full.yml auxiliary credentials (defaults are for local use only) ---
# Endpoints are wired by the full compose; only secrets are needed here.
# VAULT_TOKEN=winnowl-root          # Vault dev root token
# MINIO_USER=winnowl
# MINIO_PASS=winnowl-minio
# ARTIFACT_BUCKET=winnowl-artifacts

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-...
# Catalog model to use as a template when LLM_MODEL is not in the pi catalog (requests still use LLM_MODEL).
# LLM_TEMPLATE_MODEL=gpt-4o

# --- Review model tier (optional) ---
# Selects the model only. Each tier reads LLM_MODEL_<TIER> and falls back to LLM_MODEL; templates likewise.
# LLM_MODEL_TIER=balanced
# LLM_MODEL_QUALITY=deepseek-v4-pro
# LLM_MODEL_BALANCED=gpt-5.6-sol
# LLM_MODEL_CHEAP=gpt-5.6-mini
# LLM_TEMPLATE_MODEL_QUALITY=gpt-4o
# LLM_TEMPLATE_MODEL_CHEAP=gpt-4o

# --- Runner drain on shutdown ---
# On SIGTERM/SIGINT the runner stops claiming and waits this long for in-flight jobs before aborting
# them; a second signal skips the wait. 0 (default) = abort immediately.
# RUNNER_STOP_GRACE_PERIOD must exceed the drain + ~10s or docker SIGKILLs the runner mid-drain.
# RUNNER_DRAIN_TIMEOUT_MS=2400000
# RUNNER_STOP_GRACE_PERIOD=41m

# --- Runner lanes (independent in-flight pools) ---
# sandbox lane: review_revision, action_execute. Size by VM memory; each sandbox is capped at 2C/2G.
# RUNNER_CONCURRENCY=1
# command lane: conversation_turn.
# RUNNER_COMMAND_CONCURRENCY=2
# background lane: every other job type.
# RUNNER_BACKGROUND_CONCURRENCY=2
# Review sandbox size. REVIEW_SANDBOX_WORKSPACE=memory puts the tree on tmpfs (counts against memory).
# REVIEW_SANDBOX_CPUS=2
# REVIEW_SANDBOX_MEMORY_MB=2048
# REVIEW_SANDBOX_WORKSPACE=disk
# Fix validation image (install/lint/build/test the patched tree via registry-proxy). Unset = no validation.
# VALIDATION_SANDBOX_IMAGE=ghcr.io/lollipopkit/polyglot-ci:latest
# VALIDATION_SANDBOX_CPUS=2
# VALIDATION_SANDBOX_MEMORY_MB=4096

# --- Sandbox hosts (SANDBOX_BACKEND=agents) ---
# On live the deploy writes SANDBOX_AGENTS and APP_VERSION; set only the secret (openssl rand -hex 32).
# SANDBOX_BACKEND=agents
# SANDBOX_AGENTS=sandbox-1=http://100.64.0.2:8790=8
# SANDBOX_AGENT_SECRET=

# --- Review concurrency ---
# Console platform settings review.dig_concurrency / review.verify_concurrency / review.verify_votes;
# these env values are the fallback (DB > env > default) and must be values listed in the console.
# Total parallelism = RUNNER_CONCURRENCY x review.dig_concurrency x review.subagents. Subagents shorten a
# single scope while more dig concurrency only runs more scopes at once, so dig stays low.
# LLM_DIG_CONCURRENCY=2
# LLM_VERIFY_CONCURRENCY=16
# Independent verify votes per candidate (majority); ~N x verify cost. Default 1.
# LLM_VERIFY_VOTES=3

# --- Speed knobs (optional) ---
# Prompt cache retention: none|short|long (default long).
# LLM_CACHE_RETENTION=long
# Pre-verify dedup: token (Dice, keeps streaming) | embedding (cosine) | llm (batch clustering).
# LLM_DEDUP=token
# Required for LLM_DEDUP=embedding (OpenAI-compatible /embeddings on LLM_BASE_URL; must be ZDR-allowed):
# LLM_EMBED_MODEL=text-embedding-3-small
# LLM_DEDUP_THRESHOLD=0.86

# Cross-review finding identity: llm (default) | off (exact strong fingerprint, which misses rewritten
# claims). Falls back to fingerprints when the model fails. Separate from LLM_DEDUP on purpose: a wrong
# match here silences a real issue.
# REVIEW_FINDING_MATCH=off
# Link identical strong fingerprints without asking the model (default off):
# REVIEW_FINDING_MATCH_FAST_PATH=1
# Max current+previous items in the prompt (default 120; narrowed by category, then truncated):
# REVIEW_FINDING_MATCH_MAX_ITEMS=120

# Exploration turn cap (default 200; console platform settings override). auto = adaptive (~5-30).
# Too few turns aborts the whole run. Values must be ones listed in the console.
# REVIEW_MAX_TURNS=auto
# Tool call cap (console platform setting review.max_tool_calls; auto = profile base x change risk;
# at the cap only finishing tools are allowed):
# REVIEW_MAX_TOOL_CALLS=40

# --- Per-stage wall clock (minutes, `off` = unlimited) ---
# Fallback when the console setting is absent (DB > env > default). The sum must fit the 95 min
# sandbox limit. On deadline the stage moves on, keeping finished work. Values must be console options.
# REVIEW_STAGE_BUDGET_MAP=10
# REVIEW_STAGE_BUDGET_DIG=15
# REVIEW_STAGE_BUDGET_VERIFY=9
# REVIEW_STAGE_BUDGET_SYNTHESIS=3

# --- Secrets dir (mounted read-only at /app/.secrets in runner) ---
# Production must use an absolute path outside the deploy tree so rsync never touches it.
# If the source dir is missing docker mounts an empty dir and the runner finds no app credentials.
# SECRETS_DIR=/home/user/winnowl-secrets

# --- GitHub App ---
GITHUB_APP_ID=4312382
# Private key via mounted file (recommended) or inline PEM.
GITHUB_APP_PRIVATE_KEY_PATH=/app/.secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=change-me
BOT_NAME=winnowl
# App slug; required when it differs from BOT_NAME or bot commits are not linked to the account.
# GITHUB_APP_SLUG=winnowl

# --- BYOK (tenant-provided LLM keys; endpoints limited to official provider URLs) ---
# Fallback for the console platform setting byok.enabled.
# BYOK_ENABLED=0

# --- KMS (webhook secret / credential envelope encryption) ---
# control-api, runner and webhook must resolve the same KEK. Priority: Vault Transit > local KEK > none.
# 1) Production: Vault Transit.
# KMS_VAULT_ADDR=http://vault:8200
# KMS_VAULT_TOKEN=...            # short-lived token from AppRole/K8s auth
# KMS_VAULT_TRANSIT_KEY=winnowl
# KMS_VAULT_TRANSIT_MOUNT=transit
# 2) Self-hosted/dev: local KEK (base64, 32 bytes).
# KMS_KEK_ID=kek-1
# KMS_KEK_BASE64=...

# --- Artifact object storage (optional; without it artifacts are inline and not persisted) ---
# ARTIFACT_S3_ENDPOINT=http://minio:9000   # omit for AWS
# ARTIFACT_S3_BUCKET=winnowl-artifacts
# ARTIFACT_S3_ACCESS_KEY_ID=...
# ARTIFACT_S3_SECRET_ACCESS_KEY=...
# ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_FORCE_PATH_STYLE=true        # MinIO needs path-style

# --- Login (control-api does forge OAuth itself) ---
# Without client id/secret every request is an anonymous viewer. Use the GitHub App's own OAuth
# credentials and set its Callback URL to `<API_BASE_URL or CONSOLE_BASE_URL>/v1/auth/github/callback`.
# GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxx
# GITHUB_OAUTH_CLIENT_SECRET=...
# OIDC login. When set it is the only way to sign in; forges (GitHub, Forgejo instances) then only link
# their identity in the account page, which maps PR commenters and App installers to platform users.
# Confidential client, PKCE S256, scopes `openid email profile`, redirect URI
# `<API_BASE_URL or CONSOLE_BASE_URL>/v1/auth/oidc/callback`. Its verified emails merge accounts.
# OIDC_ISSUER=https://auth.example.com/auth/v1/   # exactly as the discovery document's `issuer`
# OIDC_CLIENT_ID=winnowl
# OIDC_CLIENT_SECRET=...
# OIDC_LABEL=Example SSO                     # button text; default = issuer host
# Required; base for redirect_uri and the CSRF origin allowlist (never inferred from Host).
# CONSOLE_BASE_URL=https://winnowl.example.com
# Session signing key (base64, >=32 bytes). Defaults to an HKDF of KMS_KEK_BASE64; neither = startup fails.
# Rotating it logs everyone out.
# SESSION_SIGNING_KEY=
# SESSION_TTL_SEC=604800                   # default 7 days
# SESSION_COOKIE_INSECURE=1                # local http only: drops the cookie Secure flag
# CSRF_ALLOWED_ORIGINS=                    # extra browser origins (comma-separated); also used for CORS
# --- Console on a different origin than the API ---
# API public URL for OAuth redirect_uri and the expected webhook URL; default = CONSOLE_BASE_URL.
# API_BASE_URL=https://winnowl-api.example.com
# Domain for the non-httpOnly login hint cookie so the console host can read it.
# SESSION_HINT_COOKIE_DOMAIN=example.com
# Bearer token for /metrics; unset = /metrics returns 404. Prometheus reads SECRETS_DIR/metrics-token.
# METRICS_TOKEN=
# Platform operators, `provider:subject` of the login identity, comma-separated (`oidc:<sub>` with OIDC login).
# PLATFORM_OPERATOR_IDENTITIES=github:10864310
# Forge origins trusted for email-based account merge (empty = disabled).
# EMAIL_MERGE_TRUSTED_ISSUERS=https://github.com,https://gitlab.com

# --- OTel (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#
# --- Langfuse (optional, self-hosted only) ---
# gen_ai.* spans are sent to Langfuse in addition to the OTel endpoint. Enabled only when all three are set.
# LANGFUSE_OTLP_ENDPOINT=https://<langfuse-host>.exe.xyz/api/public/otel
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
#
# Site root for the erasure admin API. Derived from LANGFUSE_OTLP_ENDPOINT by default; set it when the
# path is non-standard. The runner fails at startup if it cannot be derived.
# LANGFUSE_BASE_URL=https://<langfuse-host>.exe.xyz
#
# Include prompt/response bodies in spans. Off by default so customer code is not sent unless opted in.
# LLM_TRACE_BODIES=1
# LLM_TRACE_BODY_LIMIT_BYTES=32768   # per-field limit
#
# Self-hosted only: spans are a second egress path for customer code. The Langfuse host must be in the
# squid allowlist for sandbox reviews to report.

# --- Security scan private channel (optional SMTP/Mailpit) ---
# SECURITY_SMTP_HOST=mailpit
# SECURITY_SMTP_PORT=1025
# SECURITY_MAIL_FROM=winnowl@example.com
# SECURITY_MAIL_TO=security@example.com

# --- Security scan: deterministic scanner hints ---
# Scanner hits are hints for the agent; missing binaries only log. gitleaks secrets are dropped at parse time.
# SECURITY_STATIC_SCAN=0            # disable semgrep+gitleaks (default on; console: security.static_scan)
# SEMGREP_CONFIG=p/security-audit   # default ruleset

# --- Security scan: security-issue channel (default off) ---
# Issues are visible to all collaborators (public repos: everyone), so exploit details are omitted
# unless DISCLOSURE=full. Fallbacks for the console platform settings security.issue_*.
# SECURITY_ISSUE_CHANNEL=1
# SECURITY_ISSUE_MIN_SEVERITY=high  # default high
# SECURITY_ISSUE_DISCLOSURE=full    # default public (no exploit)

# --- Per-call LLM timeout ---
# Without it a gateway that holds the connection hangs the job forever while heartbeats renew the lease.
# Default 600000 (10 min); 0 disables. Passed to the review sandbox via the executor spec.
# LLM_REQUEST_TIMEOUT_MS=600000

# --- Webhook config drift check ---
# Daily compares GET /app/hook/config with `<API_BASE_URL>/webhooks/github` (or CONSOLE_BASE_URL);
# a lost webhook is otherwise silent on our side. 0 disables.
# WEBHOOK_CONFIG_CHECK_INTERVAL_DAYS=1
# GitHub does not retry failed deliveries; every N minutes redeliver failures from the last M hours (max 3 each).
# WEBHOOK_REDELIVER_INTERVAL_MINUTES=10
# WEBHOOK_REDELIVER_LOOKBACK_HOURS=6

# --- Tenant provisioning and cost limits (all default to the safe option) ---
# 1) Provisioning: allowlist (default, also on misconfig) | open | closed. Others land in
#    pending_installations for operator approval.
# TENANT_PROVISION_MODE=allowlist        # allowlist(default) | open | closed
# TENANT_PROVISION_ALLOWLIST=lollipopkit,piguk
#
# 2) Daily cost cap per tenant (platform spend only, not BYOK); stops service and notifies. Default off.
# DAILY_COST_CAP_USD=20
#
# 3) Per-review cost cap on verify fan-out; remaining candidates are neither verified nor published
#    (counted in costCappedCandidates). Default off.
# REVIEW_COST_CAP_USD=3
#
# 4) Quota warning ratio, notified once per billing period. Default 0.8; 0 disables.
#    Fallback for the console platform setting quota.warn_ratio (0.8 / 0.5 / 0.9 / 0).
# QUOTA_WARN_RATIO=0.8

# --- In-app notifications + email ---
# Notifications are stored first; email is best effort via SMTP_* to active owners/admins
# (@provider.local placeholders skipped). Failed sends retry next round.
# NOTIFICATION_EMAIL_INTERVAL_MINUTES=5
# CROSS_TENANT_INTAKE_INTERVAL_MINUTES=5

# --- Cross-tenant relationships ---
# Invite token signing secret. Unset = cross-tenant endpoints return 501.
# CROSS_TENANT_INVITE_SECRET=<random string>

# --- Periodic jobs (runner; 0/unset = off) ---
# SECURITY_SCAN_INTERVAL_DAYS=7           # full-repo LLM security scan per repo (costly)
# RELATIONSHIP_DISCOVER_INTERVAL_DAYS=7   # relationship discovery per tenant (no LLM, shallow clones)

# --- Invite email (control-api, optional) ---
# Sent only with SMTP_HOST+MAIL_FROM; otherwise invites fall back to manual tokens.
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend SMTP_PASS=<re_... API key>
# MAIL_FROM must be a full address on a verified domain (validated at startup). Alertmanager reuses SMTP_* plus:
# ALERT_EMAIL_TO=<alert recipient>; generate: cd deploy && bash ../scripts/gen-alertmanager-conf.sh
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=winnowl@example.com
# CONSOLE_BASE_URL=https://winnowl.lollipopkit.com

# --- RLS enforcement ---
# The app connects as a restricted role so RLS applies (migrations still use the owner). Unset = owner (dev).
# One-time role setup (psql as owner):
#   create role winnowl_app login password '<DB_APP_PASSWORD>';
#   grant usage on schema public to winnowl_app;
#   grant select, insert, update, delete on all tables in schema public to winnowl_app;
#   grant usage, select on all sequences in schema public to winnowl_app;
#   alter default privileges in schema public grant select, insert, update, delete on tables to winnowl_app;
#   alter default privileges in schema public grant usage, select on sequences to winnowl_app;
# DB_APP_USER=winnowl_app
# DB_APP_PASSWORD=<random>
